---
import Layout from '~/layouts/PageLayout.astro';
import Image from 'astro/components/Image.astro';
import LocationMap from '~/components/widgets/LocationMap.astro';

const metadata = {
  title: 'Dubai Branch',
  description:
    'Al Mauna Trading Dubai branch — ISO 22000 certified food distribution hub serving the GCC retail, hospitality and wellness markets.',
  image: '/src/assets/images/dubai-branch.png',
};

const baseUrl = process.env.SITE_URL ?? 'https://example.com';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: `${baseUrl}/dubai-branch`,
  name: metadata.title,
  description: metadata.description,
};

const dubaiData = [
  {
    img: '/src/assets/images/db-1.png',
    title: 'Regional reach, local insight',
    desc: 'We bridge global supply with UAE consumer needs.',
  },
  {
    img: '/src/assets/images/db-2.png',
    title: 'Premium-only portfolio',
    desc: 'Focused selection of high-quality, health-conscious brands.',
  },
  {
    img: '/src/assets/images/db-3.png',
    title: 'Operational excellence',
    desc: 'Streamlined systems from customs to final delivery.',
  },
  {
    img: '/src/assets/images/db-4.png',
    title: 'Relationship-driven service',
    desc: 'Flexible, dedicated support for every client.',
  },
  {
    img: '/src/assets/images/db-5.png',
    title: 'Future-ready growth',
    desc: 'Scalable warehousing, expanding product lines, and an upcoming UAE online store.',
  },
];

const servicesData = [
  {
    image: '/src/assets/images/Import and clearance 1.jpg',
    title: 'Import & Clearance',
    description:
      'Swift, compliant handling of global shipments into the UAE, ensuring smooth customs clearance and regulatory adherence.',
  },
  {
    image: '/src/assets/images/Warehousing and stock management 1 .jpg',
    title: 'Warehousing & Stock Management',
    description:
      'Safe storage, smart organization, and real-time inventory control to maintain product quality and operational efficiency.',
  },
  {
    image: '/src/assets/images/Wholsale distribution 1.jpg',
    title: 'Wholesale Distribution',
    description: 'Direct delivery to retailers, pharmacies, organic stores, and HORECA clients across all Emirates.',
  },
  {
    image: '/src/assets/images/Retail support.jpg',
    title: 'Retail Support',
    description: 'Merchandising, stock rotation, and strategic product placement to boost visibility and drive sales.',
  },
  {
    image: '/src/assets/images/E - commerce 1.jpg',
    title: 'E-commerce Fulfillment',
    description:
      'Launching soon, our online store will provide same-day and next-day delivery across Dubai and beyond.',
  },
  {
    image: '/src/assets/images/Client and partner support.jpg',
    title: 'Client & Partner Support',
    description:
      'Multilingual support services for client education, promotional activities, and efficient restock planning.',
  },
];
---

<Layout metadata={metadata}>
  <main>
    <script type='application/ld+json' set:html={JSON.stringify(structuredData)} />
    <section class='md:block hidden'>
      <div class='grid grid-cols-1 md:grid-cols-2'>
        <div class='bg-gradient-primary py-[96px] px-6 md:pl-[44px] md:pr-[74px]'>
          <h1
            class='text-[32px] font-bold text-white intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Dubai Branch:<br /> our gateway to the GCC
          </h1>
          <p
            class='text-[20px] pt-[32px] text-white intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            In 2025, Al Mauna Trading proudly opened its Dubai branch — a key step in bringing our trusted expertise
            from Qatar to the heart of the UAE.
            <br /><br />
            From our base in Business Bay, we serve the country’s dynamic retail, hospitality, and wellness markets with
            the same dedication to quality, innovation, and service that defines our brand. Our Dubai branch is also ISO
            22000 certified, reflecting our commitment to the highest standards of food safety management — ensuring every
            product we handle is stored, distributed, and delivered with care and compliance at every stage.
          </p>
        </div>
        <Image
          src='/src/assets/images/dubai-branch.png'
          alt='Dubai Branch'
          height={588}
          width={388}
          class='md:h-[588px] h-[334px] w-full object-cover objetc-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        />
      </div>
    </section>
    <section
      class='md:hidden'
      style='background-image:linear-gradient(180deg, #75317A 0%, rgba(130, 46, 124, 0.784801) 52.96%, rgba(179, 36, 130, 0) 100%), url(/src/assets/images/dubai-branch.png);  background-size: cover; background-position: top;'
    >
      <div class='py-[64px] mx-auto px-6'>
        <h1
          class='text-[32px] font-bold text-white intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          Dubai Branch:<br /> our gateway to the GCC
        </h1>
        <p
          class='text-[20px] pt-[32px] text-white intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          In 2025, Al Mauna Trading proudly opened its Dubai branch — a key step in bringing our trusted expertise from
          Qatar to the heart of the UAE.
          <br /><br />
          From our base in Business Bay, we serve the country’s dynamic retail, hospitality, and wellness markets with the
          same dedication to quality, innovation, and service that defines our brand. Our Dubai branch is also ISO 22000
          certified, reflecting our commitment to the highest standards of food safety management — ensuring every product
          we handle is stored, distributed, and delivered with care and compliance at every stage.
        </p>
      </div>
    </section>

    <section class='py-[58px] bg-gradient-secondary'>
      <div class='max-w-5xl mx-auto px-6'>
        <div class='text-center mb-[64px]'>
          <h2
            class='font-bold text-gradient text-[32px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Al Mauna Dubai: more than just a branch
          </h2>
          <p
            class='text-[20px] pt-2 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            It is a natural extension of a legacy built on trust and performance.
          </p>
        </div>
        <p
          class='text-[20px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          Since our beginnings in Qatar, we’ve grown into a trusted partner for sourcing and distributing premium food
          and wellness products.<br /><br />Being in Business Bay allows us to stay connected with retailers, suppliers,
          and logistics partners across the Emirates — ensuring fast, reliable, and tailored solutions.
        </p>

        <div class='flex flex-col md:flex-row md:justify-between'>
          <div
            class='text-[20px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            We specialize in:
            <br />
            <ul
              class='md:pl-[50px] pl-[20px] list-disc intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
            >
              <li>Importing globally recognized food and wellness brands</li>
              <li>Wholesale distribution to retail, hospitality, and healthcare sectors</li>
              <li>Regional warehousing and inventory management</li>
              <li>Retail-ready supply chain and merchandising support</li>
              <li>Customer-first service, tailored to UAE expectations</li>
            </ul>
            <br />
            Our mission is simple: deliver value, from source to shelf.
          </div>
          <div
            class='flex justify-center pt-[24px] md:pt-0 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            <Image
              src='/src/assets/images/iso.svg'
              title='iso-image'
              alt='iso-image'
              height={100}
              width={150}
              class='md:h-[150px] md:w-[150px] h-[100px] w-[100px] object-cover object-center mr-[10px]'
            />
            <Image
              src='/src/assets/images/iso-2.png'
              title='iso-image'
              alt='iso-image'
              height={100}
              width={150}
              class='md:h-[150px] md:w-[150px] h-[100px] w-[100px] object-cover object-center mr-[10px]'
            />
          </div>
        </div>
      </div>
    </section>
    <section class='py-[58px]'>
      <div class='max-w-6xl mx-auto px-6'>
        <div class='text-center mb-[32px]'>
          <h2
            class='font-bold text-gradient text-[32px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            What we do in Dubai
          </h2>
          <p
            class='text-[20px] pt-2 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Our Dubai hub operates as a full-service supply and distribution center,<br class='md:block hidden' />
            designed to meet the fast-paced demands of the UAE market.
          </p>
        </div>
        <p class='text-[20px] text-center'>Our core capabilities in Dubai include:</p>

        <div class='grid grid-cols-1 md:grid-cols-3 gap-[38px] my-[58px]'>
          {
            servicesData.map((item) => (
              <div>
                <div class='p-4 rounded-[8px] bg-white shadow-secondary hover:shadow-lg h-full intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
                  <div class='overflow-hidden rounded-[8px] mb-4'>
                    <img
                      src={item.image}
                      class='h-44 w-full object-cover transition-transform duration-300 hover:scale-110'
                    />
                  </div>
                  <h3 class='text-[18px] font-bold text-gradient mb-2'>{item.title}</h3>
                  <p class='text-[16px]'>{item.description}</p>
                </div>
              </div>
            ))
          }
        </div>

        <p
          class='text-[20px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          From supermarkets and specialty shops to hotels and wellness chains, we ensure premium products reach shelves
          fresh and on time.
        </p>
      </div>
    </section>

    <section
      class='py-[58px]'
      style={{
        backgroundImage: 'url(/src/assets/images/violet-bg.svg)',
        backgroundRepeat: 'no-repeat',
        backgroundSize: 'cover',
        backgroundPosition: 'center',
      }}
    >
      <div class='max-w-6xl mx-auto px-6'>
        <div class='flex flex-col items-center'>
          <h1
            class='text-[32px] font-bold text-gradient-secondary text-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Driven by purpose, inspired by vision
          </h1>
          <p
            class='text-[20px] pt-2 text-[#F6E9F2] text-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Quality in every step, ambition in every move.
          </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-5 gap-[48px] md:gap-[28px] mt-[64px]'>
          {
            dubaiData.map((item) => (
              <div class='intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade '>
                <div class='flex relative items-center justify-center hover:scale-110'>
                  <div class='bg-gradient-tertiary rotate-[45deg] h-[80px] w-[80px] rounded-[8px]' />
                  <Image
                    src={item.img}
                    height={111}
                    width={96}
                    class='w-[110px] h-[111px] absolute object-center object-cover'
                    alt={item.title}
                  />
                </div>
                <h1 class='text-[16px] font-bold text-gradient-secondary text-center pt-[20px] md:pt-[46px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
                  {item.title}
                </h1>

                <p class='text-[14px] text-[#F6E9F2] text-center pt-1 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class='py-[58px] bg-gradient-secondary md:hidden'>
      <div class='max-w-6xl mx-auto px-6'>
        <div class='md:mb-[48px]'>
          <h2 class='font-bold text-gradient text-[32px] text-center'>Regional export from UAE</h2>

          <p class='text-[20px] pt-2 text-center'>
            At Al Mauna Trading – Dubai, we’re here to connect global quality with local needs — today, and for the
            future.
          </p>
        </div>
      </div>
    </section>

    <section class='pt-[58px] md:block hidden'>
      <div class='max-w-6xl mx-auto'>
        <div class='flex gap-[32px]'>
          <div
            class='bg-gradient-secondary rounded-[8px] py-10 px-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            <h2 class='font-bold text-gradient text-[32px] text-center'>Regional export from UAE</h2>
          </div>
          <div
            class='bg-gradient-secondary rounded-[8px] py-10 px-10 flex justify-center items-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            <p class='text-[20px]'>
              At Al Mauna Trading – Dubai, we’re here to connect global quality with local needs — today, and for the
              future.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class='py-[58px] px-6'>
      <div class='max-w-6xl mx-auto border rounded-[8px]'>
        <div class='grid grid-cols-1 lg:grid-cols-3 gap-y-[48px] md:gap-[48px]'>
          <!-- Map Section -->
          <div class='col-span-1'>
            <LocationMap
              mapId='map-container-dubai'
              officeLocation={{
                name: 'Office',
                address: 'Office No: 2105-0184, The Binary by Omniyat, Business Bay, Dubai, United Arab Emirates',
                coords: { lat: 25.1972, lng: 55.2744 },
                mapUrl: 'https://maps.google.com/?q=The+Binary+by+Omniyat,+Business+Bay,+Dubai,+UAE',
                color: '#dc2626',
              }}
              warehouseLocation={{
                name: 'Warehouse',
                address: 'Ocean Fair International, Dubai',
                coords: { lat: 25.2048, lng: 55.2708 },
                mapUrl: 'https://maps.google.com/?q=Ocean+Fair+International,+Dubai,+UAE',
                color: '#2563eb',
              }}
            />
          </div>

          <!-- Contact Information Section -->
          <div
            class='md:flex flex-row justify-between items-start col-span-2 px-6 md:pl-[40px] md:py-[48px] pb-[48px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            <div>
              <h2 class='text-[24px] text-gradient font-bold md:mb-[16px] mb-[32px]'>UAE Office</h2>
              <!-- Office -->
              <div>
                <h3 class='text-[16px] font-bold text-black text-opacity-[50%] mb-[4px]'>ADDRESS</h3>
                <p class='text-[20px] text-[#B32482] underline mb-[16px]'>
                  Office No: 2105-0184, The Binary by Omniyat,<br class='md:block hidden' /> Business Bay, Dubai, United
                  Arab Emirates
                </p>
              </div>
              <div class='mt-[16px] md:hidden'>
                <a
                  href='https://maps.google.com/?q=The+Binary+by+Omniyat,+Business+Bay,+Dubai,+UAE'
                  target='_blank'
                  rel='noopener noreferrer'
                  class='inline-block px-[16px] py-[8px] shadow-secondary bg-white text-gradient text-[14px] rounded-[32px] font-bold'
                >
                  Get Directions
                </a>
              </div>

              <!-- Warehouse -->
              <div class='md:mt-[16px] mt-[32px]'>
                <h3 class='text-[16px] font-bold text-black text-opacity-[50%] mb-[4px]'>WAREHOUSE</h3>
                <p class='text-[20px]'>Ocean Fair International, Dubai</p>
              </div>

              <!-- Phone -->
              <div class='md:mt-[16px] mt-[32px]'>
                <h3 class='text-[16px] font-bold text-black text-opacity-[50%] mb-[4px]'>PHONE</h3>
                <div>
                  <a href='tel:+971504789777' class='text-[20px] text-[#B32482] underline'> +971504789777 </a>
                  <br />
                  <a href='tel:+971425880070' class='text-[20px] text-[#B32482] underline'> +971425880070 </a>
                </div>
              </div>

              <!-- Email -->
              <div class='md:mt-[16px] mt-[32px]'>
                <h3 class='text-[16px] font-bold text-black text-opacity-[50%] mb-[4px]'>E-MAIL</h3>
                <a href='mailto:sales.uae@almauna.com' class='text-[20px] text-[#B32482] underline'>
                  sales.uae@almauna.com
                </a>
              </div>

              <!-- Opening Hours -->
              <div class='md:mt-[16px] mt-[32px]'>
                <h3 class='text-[16px] font-bold text-black text-opacity-[50%] mb-[4px]'>OPENING HOURS</h3>
                <p class='text-[20px]'>Mon – Fri: 8:00 AM – 5:00 PM</p>
              </div>
            </div>

            <div
              class='md:mt-[60px] md:block hidden md:mr-[70px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
            >
              <a
                href='https://maps.google.com/?q=The+Binary+by+Omniyat,+Business+Bay,+Dubai,+UAE'
                target='_blank'
                rel='noopener noreferrer'
                class='inline-block px-[16px] py-[8px] shadow-secondary bg-white text-gradient text-[14px] rounded-[32px] font-bold'
              >
                Get Directions
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class='pt-[58px] pb-[120px] bg-gradient-secondary'>
      <div class='max-w-5xl mx-auto px-6'>
        <h1
          class='text-[32px] font-bold text-gradient text-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          Your products, delivered with care
        </h1>
        <p
          class='text-[20px] text-center mt-[8px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          Get a competitive quote and discover how Al Mauna can streamline your sourcing and distribution.
        </p>
        <div
          class='flex justify-center items-center mt-[48px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          <a
            href='https://wa.me/97433560938'
            target='_blank'
            class='bg-gradient-primary py-[16px] px-[32px] shadow-primary rounded-[32px] text-white font-bold text-[16px] hover:scale-105 transition-transform duration-200 ease-in-out'
            >Get a Quote</a
          >
        </div>
      </div>
    </section>
  </main>
</Layout>
