---
import Layout from '~/layouts/PageLayout.astro';
import Image from 'astro/components/Image.astro';
import LocationMap from '~/components/widgets/LocationMap.astro';
import whatsappIcon from '~/assets/images/whatsapp-icon.png';

const metadata = {
  title: 'Dubai Branch',
  description:
    'Al Mauna Trading Dubai branch — ISO 22000 certified food distribution hub serving the GCC retail, hospitality and wellness markets.',
  image: '/src/assets/images/dubai_branch.webp',
};

const baseUrl = process.env.SITE_URL ?? 'https://example.com';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: `${baseUrl}/dubai-branch`,
  name: metadata.title,
  description: metadata.description,
};

const dubaiData = [
  {
    img: '/src/assets/images/db-1.png',
    title: 'Regional reach, local insight',
    desc: 'We bridge global supply with UAE consumer needs.',
  },
  {
    img: '/src/assets/images/db-2.png',
    title: 'Premium-only portfolio',
    desc: 'Focused selection of high-quality, health-conscious brands.',
  },
  {
    img: '/src/assets/images/db-3.png',
    title: 'Operational excellence',
    desc: 'Streamlined systems from customs to final delivery.',
  },
  {
    img: '/src/assets/images/db-4.png',
    title: 'Relationship-driven service',
    desc: 'Flexible, dedicated support for every client.',
  },
  {
    img: '/src/assets/images/db-5.png',
    title: 'Future-ready growth',
    desc: 'Scalable warehousing, expanding product lines, and an upcoming UAE online store.',
  },
];

const servicesData = [
  {
    image: '/src/assets/images/Photography/RegionalReach.png',
    title: 'Import & Clearance',
    description: 'Swift, compliant handling of global shipments into the UAE.',
  },
  {
    image: '/src/assets/images/Photography/Warehousing&StockManagement.png',
    title: 'Warehousing & Stock Management',
    description: 'Safe storage, smart organization, and real-time inventory control.',
  },
  {
    image: '/src/assets/images/Photography/WholesaleDistribution.png',
    title: 'Wholesale Distribution',
    description: 'Direct delivery to retailers, pharmacies, organic stores, and HORECA clients across all Emirates.',
  },
  {
    image: '/src/assets/images/Photography/RetailSupport.png',
    title: 'Retail Support',
    description: 'Merchandising, stock rotation, and product placement to boost visibility and sales.',
  },

  {
    image: '/src/assets/images/Photography/Client&PartnerSupport.png',
    title: 'Client & Partner Support',
    description: 'Multilingual service for education, promotions, and restock planning.',
  },
];

// {
//     image: '/src/assets/images/Photography/EcommerceFullfillment.png',
//     title: 'E-commerce Fulfillment',
//     description:
//       'Launching soon, our online store will provide same-day and next-day delivery across Dubai and beyond.',
//   },
---

<Layout metadata={metadata}>
  <main>
    <script type='application/ld+json' set:html={JSON.stringify(structuredData)} />
    <section class='md:block hidden'>
      <div class='grid grid-cols-1 md:grid-cols-2'>
        <div class='bg-gradient-primary py-[96px] px-6 md:pl-[44px] md:pr-[74px]'>
          <h1
            class='text-[32px] font-bold text-white intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Dubai Branch:<br /> our gateway to the GCC
          </h1>
          <p
            class='text-[20px] pt-[32px] text-white intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            In 2025, Al Mauna Trading proudly opened its Dubai branch — a key step in bringing our trusted expertise
            from Qatar to the heart of the UAE.
            <br /><br />
            From our base in Rag Biz HQ Business Centre, we serve the country’s dynamic retail, hospitality, and wellness
            markets with the same dedication to quality, innovation, and service that defines our brand. Our Dubai branch
            is also ISO 22000 certified, reflecting our commitment to the highest standards of food safety management — ensuring
            every product we handle is stored, distributed, and delivered with care and compliance at every stage.
          </p>
        </div>
        <Image
          src='/src/assets/images/dubai_branch.webp'
          alt='Dubai Branch'
          height={588}
          width={388}
          class='md:h-[588px] h-[334px] w-full object-cover objetc-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        />
      </div>
    </section>
    <section
      class='md:hidden'
      style='background-image:linear-gradient(180deg, #75317A 0%, rgba(130, 46, 124, 0.784801) 52.96%, rgba(179, 36, 130, 0) 100%), url(/src/assets/images/dubai_branch.webp);  background-size: cover; background-position: top;'
    >
      <div class='py-[64px] mx-auto px-6'>
        <h1
          class='text-[32px] font-bold text-white intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          Dubai Branch:<br /> our gateway to the GCC
        </h1>
        <p
          class='text-[20px] pt-[32px] text-white intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          In 2025, Al Mauna Trading proudly opened its Dubai branch — a key step in bringing our trusted expertise from
          Qatar to the heart of the UAE.
          <br /><br />
          From our base in Rag Biz HQ Business Centre, we serve the country’s dynamic retail, hospitality, and wellness markets
          with the same dedication to quality, innovation, and service that defines our brand. Our Dubai branch is also ISO
          22000 certified, reflecting our commitment to the highest standards of food safety management — ensuring every
          product we handle is stored, distributed, and delivered with care and compliance at every stage.
        </p>
      </div>
    </section>

    <section class='py-[58px]'>
      <div class='max-w-5xl mx-auto px-6'>
        <div class='text-center mb-[64px]'>
          <h2
            class='font-bold text-gradient text-[32px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Al Mauna Dubai: more than just a branch
          </h2>
          <p
            class='text-[20px] pt-2 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            It is a natural extension of a legacy built on trust and performance.
          </p>
        </div>
        <p
          class='text-[20px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
        >
          Since our beginnings in Qatar, we’ve grown into a trusted partner for sourcing and distributing premium food
          and wellness products.<br /><br />Being in Rag Biz HQ Business Centre allows us to stay connected with
          retailers, suppliers, and logistics partners across the Emirates — ensuring fast, reliable, and tailored
          solutions.
        </p>

        <div class='flex flex-col md:flex-row md:justify-between'>
          <div
            class='text-[20px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            We specialize in:
            <br />
            <ul
              class='md:pl-[50px] pl-[20px] list-disc intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
            >
              <li>Importing globally recognized food and wellness brands</li>
              <li>Wholesale distribution to retail, hospitality, and healthcare sectors</li>
              <li>Regional warehousing and inventory management</li>
              <li>Retail-ready supply chain and merchandising support</li>
              <li>Customer-first service, tailored to UAE expectations</li>
            </ul>
            <br />
            Our mission is simple: deliver value, from source to shelf.
          </div>
          <div
            class='flex justify-center pt-[24px] md:pt-0 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            <Image
              src='/src/assets/images/iso-1.webp'
              title='iso-image'
              alt='iso-image'
              height={100}
              width={150}
              class='md:h-[150px] md:w-[150px] h-[100px] w-[100px] object-cover object-center mr-[10px]'
            />
            <Image
              src='/src/assets/images/iso-2.webp'
              title='iso-image'
              alt='iso-image'
              height={100}
              width={150}
              class='md:h-[150px] md:w-[150px] h-[100px] w-[100px] object-cover object-center mr-[10px]'
            />
          </div>
        </div>
      </div>
    </section>
    <section
      class='pt-[58px] pb-[58px] md:pb-[64px]'
      style={{
        backgroundImage:
          'linear-gradient(89.17deg, rgba(179, 36, 130, 0.1) 0%, rgba(117, 49, 122, 0.1) 100%), url(/src/assets/images/Polygons.svg)',
        backgroundRepeat: 'no-repeat',
        backgroundSize: 'cover',
        backgroundPosition: 'center',
      }}
    >
      <div class='max-w-6xl mx-auto px-6'>
        <div class='text-center mb-[32px]'>
          <h2
            class='font-bold text-gradient text-[32px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            What we do in Dubai
          </h2>
          <p
            class='text-[20px] pt-2 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Our Dubai hub operates as a full-service supply and distribution center,<br class='md:block hidden' />
            designed to meet the fast-paced demands of the UAE market.
          </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-5 gap-[48px] md:gap-[32px] mt-[58px]'>
          {
            servicesData.map((item) => (
              <div class='intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade '>
                <div class='flex relative items-center justify-center lg:hover:scale-110'>
                  <div class='bg-gradient-tertiary rotate-[45deg] h-[80px] w-[80px] rounded-[8px]' />
                  <Image
                    src={item.image}
                    height={111}
                    width={96}
                    class='w-[110px] h-[111px] absolute object-center object-cover'
                    alt={item.title}
                  />
                </div>
                <h1 class='text-[16px] font-bold text-gradient text-center pt-[32px] md:pt-[32px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
                  {item.title}
                </h1>

                <p class='text-[14px] text-center pt-1 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
                  {item.description}
                </p>
              </div>
            ))
          }
        </div>

        <div class='mt-[64px] mx-auto px-6 lg:px-0 max-w-sm flex flex-row relative'>
          <div
            class='bg-gradient-primary text-white font-bold text-[14px] py-[12px] px-[20px] rounded-[8px] absolute md:left-[-124px] lfet-[-50px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Coming Soon
          </div>
          <div
            class='flex flex-col md:flex-row intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            <div class='flex relative items-center md:gap-[32px] justify-center lg:hover:scale-110'>
              <div class='bg-gradient-tertiary rotate-[45deg] h-[80px] w-[80px] rounded-[8px]'></div>
              <Image
                src='/src/assets/images/Photography/EcommerceFullfillment.png'
                height={111}
                width={96}
                class='md:w-[110px] md:h-[111px] absolute object-center object-cover'
                alt='E-commerce fulfillment'
              />
            </div>
            <div class='md:ml-8 md:mt-0 mt-[32px]'>
              <h1
                class='text-[16px] font-bold text-gradient text-center pt-[20px] md:pt-0 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
              >
                E-commerce fulfillment
              </h1>
              <p
                class='text-[14px] text-center pt-1 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
              >
                Launching soon, our online<br class='md:block hidden' /> store will offer same-day and <br
                  class='md:block hidden'
                />next-day delivery across<br class='md:block hidden' /> Dubai and beyond.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      class='py-[58px]'
      style={{
        backgroundImage: 'url(/src/assets/images/violet-bg.svg)',
        backgroundRepeat: 'no-repeat',
        backgroundSize: 'cover',
        backgroundPosition: 'center',
      }}
    >
      <div class='max-w-6xl mx-auto px-6'>
        <div class='flex flex-col items-center'>
          <h1
            class='text-[32px] font-bold text-gradient-secondary text-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Driven by purpose, inspired by vision
          </h1>
          <p
            class='text-[20px] pt-2 text-[#F6E9F2] text-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            Quality in every step, ambition in every move.
          </p>
        </div>

        <div class='grid grid-cols-1 md:grid-cols-5 gap-[48px] md:gap-[28px] mt-[58px]'>
          {
            dubaiData.map((item) => (
              <div class='intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade '>
                <div class='flex relative items-center justify-center lg:hover:scale-110'>
                  <div class='bg-gradient-tertiary rotate-[45deg] h-[80px] w-[80px] rounded-[8px]' />
                  <Image
                    src={item.img}
                    height={111}
                    width={96}
                    class='w-[110px] h-[111px] absolute object-center object-cover'
                    alt={item.title}
                  />
                </div>
                <h1 class='text-[16px] font-bold text-gradient-secondary text-center pt-[20px] md:pt-[46px] intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
                  {item.title}
                </h1>

                <p class='text-[14px] text-[#F6E9F2] text-center pt-1 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'>
                  {item.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class='py-[58px] bg-gradient-secondary md:hidden'>
      <div class='max-w-6xl mx-auto px-6'>
        <div class='md:mb-[48px]'>
          <h2 class='font-bold text-gradient text-[32px] text-center'>Regional export from UAE</h2>

          <p class='text-[20px] pt-2 text-center'>
            At Al Mauna Trading – Dubai, we’re here to connect global quality with local needs — today, and for the
            future.
          </p>
        </div>
      </div>
    </section>

    <section class='pt-[58px] md:block hidden'>
      <div class='max-w-6xl mx-auto'>
        <div class='flex gap-[32px]'>
          <div
            class='bg-gradient-secondary rounded-[8px] py-10 px-8 intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            <h2 class='font-bold text-gradient text-[32px] text-center'>Regional export from UAE</h2>
          </div>
          <div
            class='bg-gradient-secondary rounded-[8px] py-10 px-10 flex justify-center items-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
          >
            <p class='text-[20px]'>
              At Al Mauna Trading – Dubai, we’re here to connect global quality with local needs — today, and for the
              future.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class='py-[58px] pb-[106px] px-6'>
      <div class='max-w-6xl mx-auto'>
        <!-- UAE Office -->
        <div class='space-y-6 text-left'>
          <h3 class='text-gradient font-bold text-[24px]'>UAE Office</h3>

          <div class='flex flex-wrap gap-3'>
            <!-- Whatspp Pill -->
            <a
              href='https://wa.me/971504789777'
              class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm'
            >
              <Image src={whatsappIcon} alt='WhatsApp Icon' class='w-5 h-5' />
            </a>

            <!-- Mobile Pill -->
            <a
              href='tel:+971504789777'
              class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm min-w-[140px]'
            >
              <i class='fa-solid fa-mobile-screen-button text-gradient text-xl'></i>
              <div class='flex flex-col items-start'>
                <span class='text-[9px] font-bold text-black/40 uppercase leading-none mb-1'>Mobile</span>
                <span class='text-[14px] font-bold text-gradient leading-none'>+971 5047 89777</span>
              </div>
            </a>

            <!-- Phone Pill -->
            <a
              href='tel:+971 42588070'
              class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm min-w-[140px]'
            >
              <i class='fa-solid fa-phone text-gradient text-xl'></i>
              <div class='flex flex-col items-start'>
                <span class='text-[9px] font-bold text-black/40 uppercase leading-none mb-1'>Phone</span>
                <span class='text-[14px] font-bold text-gradient leading-none'>+971 42588070</span>
              </div>
            </a>

            <!-- Email Pill -->
            <a
              href='mailto:sales.uae@almauna.com'
              class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm min-w-[140px]'
            >
              <i class='fa-solid fa-envelope text-gradient text-xl'></i>
              <div class='flex flex-col items-start'>
                <span class='text-[9px] font-bold text-black/40 uppercase leading-none mb-1'>E-mail</span>
                <span class='text-[14px] font-bold text-gradient leading-none'>sales.uae@almauna.com</span>
              </div>
            </a>
          </div>

          <!-- Address Card -->
          <div class='bg-white rounded-2xl overflow-hidden flex flex-col md:flex-row shadow-sm border border-black/5'>
            <!-- Map Thumbnail -->
            <div class='md:w-[40%] min-h-[220px] bg-gray-100'>
              <div>
                <LocationMap
                  mapId='map-container-dubai'
                  autoOpenInfoWindow={false}
                  officeLocation={{
                    name: 'Office',
                    address:
                      'Office 3-43, A Diyar - Office 3, Rag Biz HQ Business Centre, Al Wasl, Sheikh Zayed Rd - Dubai, United Arab Emirates.',
                    coords: { lat: 25.1876791, lng: 55.2553689 },
                    mapUrl: 'https://maps.google.com/?q=RAG+Biz+HQ+%7C+Business+Centre+in+Dubai',
                    color: '#dc2626',
                  }}
                  warehouseLocation={{
                    name: 'Warehouse',
                    address: 'Ocean Fair International, Dubai',
                    coords: { lat: 24.9351731, lng: 55.0484003 },
                    mapUrl: 'https://maps.google.com/?q=Ocean+Fair+International,+Dubai,+UAE',
                    color: '#2563eb',
                  }}
                />
              </div>
            </div>
            <!-- Details -->
            <div class='p-6 md:w-[60%] space-y-4'>
              <div>
                <h4 class='text-[11px] font-bold text-black/40 uppercase mb-1'>Address</h4>
                <p class='text-[14px] text-gradient underline font-medium leading-tight'>
                  Office 3-43, A Diyar - Office 3, Rag Biz HQ Business Centre, Al Wasl, Sheikh Zayed Rd - Dubai, United
                  Arab Emirates.
                </p>
                <a
                  href='https://maps.google.com/?q=RAG+Biz+HQ+%7C+Business+Centre+in+Dubai'
                  target='_blank'
                  class='inline-block mt-3 px-6 py-1 border border-[#75317A33] rounded-full text-[12px] font-bold text-gradient hover:bg-[#75317A0D] transition-colors'
                >
                  Get Directions
                </a>
              </div>
              <div>
                <h4 class='text-[11px] font-bold text-black/40 uppercase mb-0.5'>Warehouse</h4>
                <p class='text-[14px] font-semibold text-black/80'>Ocean Fair International, Dubai</p>
              </div>
              <div>
                <h4 class='text-[11px] font-bold text-black/40 uppercase mb-0.5'>Opening Hours</h4>
                <p class='text-[14px] font-semibold text-black/80'>Mon - Sat: 8:00 AM - 5:00 PM</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main></Layout
>
