---
import { Image } from 'astro:assets';
import Layout from '~/layouts/PageLayout.astro';
import LocationMap from '~/components/widgets/LocationMap.astro';
import whatsappIcon from '~/assets/images/whatsapp-icon.png';

const metadata = {
  title: 'Contact',
  description:
    'Contact Al Mauna Trading for enquiries, quotations and partnership opportunities across Qatar and the UAE.',
  image: '/src/assets/images/contact-hero.png',
};

const baseUrl = process.env.SITE_URL ?? 'https://example.com';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  url: `${baseUrl}/contact`,
  name: metadata.title,
  description: metadata.description,
};
---

<Layout metadata={metadata}>
  <main>
    <script type='application/ld+json' set:html={JSON.stringify(structuredData)} />
    <section class='grid grid-cols-1 lg:grid-cols-2 min-h-screen'>
      <!-- Left Column: Contact Form -->
      <div
        class='bg-[#F9F5F8] py-20 px-6 lg:px-10 flex flex-col items-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
      >
        <div class='max-w-md w-full text-center'>
          <h2 class='text-[32px] text-gradient font-bold'>Contact us</h2>
          <p class='text-[20px] pt-2 text-black/70'>
            We're here to connect. Reach us anytime through our offices or send us a message.
          </p>

          <form class='pt-[40px] space-y-4 text-left'>
            <div class='border-gradient-secondary rounded-[8px]'>
              <input
                type='text'
                placeholder='Full name'
                class='w-full px-1 py-3 focus:outline-none bg-white rounded-[8px] placeholder:text-black placeholder:opacity-50'
              />
            </div>

            <div class='border-gradient-secondary rounded-[8px]'>
              <input
                type='text'
                placeholder='Company name'
                class='w-full px-1 py-3 focus:outline-none bg-white rounded-[8px] placeholder:text-black placeholder:opacity-50'
              />
            </div>

            <div class='border-gradient-secondary rounded-[8px]'>
              <input
                type='email'
                placeholder='E-mail'
                class='w-full px-1 py-3 focus:outline-none bg-white rounded-[8px] placeholder:text-black placeholder:opacity-50'
              />
            </div>

            <div class='border-gradient-secondary rounded-[8px]'>
              <input
                type='text'
                placeholder='Phone number'
                class='w-full px-1 py-3 focus:outline-none bg-white rounded-[8px] placeholder:text-black placeholder:opacity-50'
              />
            </div>

            <div class='border-gradient-secondary rounded-[8px]'>
              <textarea
                placeholder='Message'
                rows='5'
                class='w-full px-1 py-3 focus:outline-none bg-white rounded-[8px] placeholder:text-black placeholder:opacity-50'
              ></textarea>
            </div>

            <div class='flex justify-center pt-[32px]'>
              <button
                type='submit'
                class='px-16 py-3 rounded-[32px] focus:outline-none text-white font-bold text-[16px] bg-gradient-primary shadow-md hover:opacity-90 hover:scale-105 transition-transform duration-200 ease-in-out'
              >
                Send Message
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- Right Column: Al Mauna Offices -->
      <div
        class='bg-white py-20 pb-[6rem] px-6 lg:px-10 flex flex-col items-center intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
      >
        <div class='max-w-xl w-full text-center'>
          <h2 class='text-[32px] text-gradient font-bold'>Al Mauna Offices</h2>
          <p class='text-[20px] pt-2 mb-12 text-black/70'>Visit your nearest branch to connect with our team.</p>

          <div class='flex flex-col gap-16'>
            <!-- Head Office -->
            <div class='space-y-6 text-left'>
              <h3 class='text-gradient font-bold text-[24px]'>Head Office</h3>

              <div class='flex flex-wrap gap-3'>
                <!-- Whatspp Pill -->
                <a
                  href='https://wa.me/97433560938'
                  class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm'
                >
                  <Image src={whatsappIcon} alt='WhatsApp Icon' class='w-5 h-5' />
                </a>

                <!-- Mobile Pill -->
                <a
                  href='tel:+97433560938'
                  class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm min-w-[140px]'
                >
                  <i class='fa-solid fa-mobile-screen-button text-gradient text-xl'></i>
                  <div class='flex flex-col items-start'>
                    <span class='text-[9px] font-bold text-black/40 uppercase leading-none mb-1'>Mobile</span>
                    <span class='text-[14px] font-bold text-gradient leading-none'>+974 3356 0938</span>
                  </div>
                </a>
                <!-- Phone Pill -->
                <a
                  href='tel:+97444416966'
                  class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm min-w-[140px]'
                >
                  <i class='fa-solid fa-phone text-gradient text-xl'></i>
                  <div class='flex flex-col items-start'>
                    <span class='text-[9px] font-bold text-black/40 uppercase leading-none mb-1'>Phone</span>

                    <span class='text-[14px] font-bold text-gradient leading-none'>+974 4441 6966</span>
                  </div>
                </a>
                <!-- Email Pill -->
                <a
                  href='mailto:sales@almauna.com'
                  class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm min-w-[140px]'
                >
                  <i class='fa-solid fa-envelope text-gradient text-xl'></i>
                  <div class='flex flex-col items-start'>
                    <span class='text-[9px] font-bold text-black/40 uppercase leading-none mb-1'>E-mail</span>
                    <span class='text-[14px] font-bold text-gradient leading-none'>sales@almauna.com</span>
                  </div>
                </a>
              </div>

              <!-- Address Card -->
              <div
                class='bg-white rounded-2xl overflow-hidden flex flex-col md:flex-row shadow-sm border border-black/5'
              >
                <!-- Map Thumbnail -->
                <div class='md:w-[40%] min-h-[220px] bg-gray-100'>
                  <LocationMap
                    mapId='map-container-qatar'
                    autoOpenInfoWindow={false}
                    officeLocation={{
                      name: 'Office',
                      address: 'Office #37, Al Emadi Business Center, C Ring Road, Doha, Qatar',
                      coords: { lat: 25.262604, lng: 51.5366315 },
                      mapUrl: 'https://maps.google.com/?q=Al+Emadi+Business+Center,+C+Ring+Road,+Doha,+Qatar',
                      color: '#dc2626',
                    }}
                    warehouseLocation={{
                      name: 'Warehouse',
                      address: 'Milaha Warehouse, Doha - Qatar',
                      coords: { lat: 25.160923, lng: 51.467017 },
                      mapUrl:
                        'https://www.google.com/maps/search/Milaha+Warehouse,+Doha,+Qatar/@25.1590559,51.4658048,18z/data=!3m1!4b1?entry=ttu',
                      color: '#2563eb',
                    }}
                  />
                </div>
                <!-- Details -->
                <div class='p-6 md:w-[60%] space-y-4'>
                  <div>
                    <h4 class='text-[11px] font-bold text-black/40 uppercase mb-1'>Address</h4>
                    <p class='text-[14px] text-gradient underline font-medium leading-tight'>
                      Office #37, Al Emadi Business Center, C Ring Road, Doha, Qatar
                    </p>
                    <a
                      href='https://maps.google.com/?q=Al+Emadi+Business+Center,+C+Ring+Road,+Doha,+Qatar'
                      target='_blank'
                      class='inline-block mt-3 px-6 py-1 border border-[#75317A33] rounded-full text-[12px] font-bold text-gradient hover:bg-[#75317A0D] transition-colors'
                    >
                      Get Directions
                    </a>
                  </div>
                  <div>
                    <h4 class='text-[11px] font-bold text-black/40 uppercase mb-0.5'>Warehouse</h4>
                    <p class='text-[14px] font-semibold text-black/80'>Milaha Warehouse, Doha - Qatar</p>
                  </div>
                  <div>
                    <h4 class='text-[11px] font-bold text-black/40 uppercase mb-0.5'>Opening Hours</h4>
                    <p class='text-[14px] font-semibold text-black/80'>Sat - Thu: 8:00 AM - 5:00 PM</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- UAE Office -->
            <div class='space-y-6 text-left'>
              <h3 class='text-gradient font-bold text-[24px]'>UAE Office</h3>

              <div class='flex flex-wrap gap-3'>
                <!-- Whatspp Pill -->
                <a
                  href='https://wa.me/971504789777'
                  class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm'
                >
                  <Image src={whatsappIcon} alt='WhatsApp Icon' class='w-5 h-5' />
                </a>

                <!-- Mobile Pill -->
                <a
                  href='tel:+971504789777'
                  class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm min-w-[140px]'
                >
                  <i class='fa-solid fa-mobile-screen-button text-gradient text-xl'></i>
                  <div class='flex flex-col items-start'>
                    <span class='text-[9px] font-bold text-black/40 uppercase leading-none mb-1'>Mobile</span>
                    <span class='text-[14px] font-bold text-gradient leading-none'>+971 5047 89777</span>
                  </div>
                </a>

                <!-- Phone Pill -->
                <a
                  href='tel:+971 42588070'
                  class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm min-w-[140px]'
                >
                  <i class='fa-solid fa-phone text-gradient text-xl'></i>
                  <div class='flex flex-col items-start'>
                    <span class='text-[9px] font-bold text-black/40 uppercase leading-none mb-1'>Phone</span>
                    <span class='text-[14px] font-bold text-gradient leading-none'>+971 42588070</span>
                  </div>
                </a>

                <!-- Email Pill -->
                <a
                  href='mailto:sales.uae@almauna.com'
                  class='flex items-center gap-3 px-4 py-2 bg-[#F9F5F8] rounded-xl group hover:scale-105 transition-transform shadow-sm min-w-[140px]'
                >
                  <i class='fa-solid fa-envelope text-gradient text-xl'></i>
                  <div class='flex flex-col items-start'>
                    <span class='text-[9px] font-bold text-black/40 uppercase leading-none mb-1'>E-mail</span>
                    <span class='text-[14px] font-bold text-gradient leading-none'>sales.uae@almauna.com</span>
                  </div>
                </a>
              </div>

              <!-- Address Card -->
              <div
                class='bg-white rounded-2xl overflow-hidden flex flex-col md:flex-row shadow-sm border border-black/5'
              >
                <!-- Map Thumbnail -->
                <div class='md:w-[40%] min-h-[220px] bg-gray-100'>
                  <div>
                    <LocationMap
                      mapId='map-container-dubai'
                      autoOpenInfoWindow={false}
                      officeLocation={{
                        name: 'Office',
                        address:
                          'Office 3-43, A Diyar - Office 3, Rag Biz HQ Business Centre, Al Wasl, Sheikh Zayed Rd - Dubai, United Arab Emirates.',
                        coords: { lat: 25.1876791, lng: 55.2553689 },
                        mapUrl: 'https://maps.google.com/?q=RAG+Biz+HQ+%7C+Business+Centre+in+Dubai',
                        color: '#dc2626',
                      }}
                      warehouseLocation={{
                        name: 'Warehouse',
                        address: 'Ocean Fair International, Dubai',
                        coords: { lat: 24.9351731, lng: 55.0484003 },
                        mapUrl: 'https://maps.google.com/?q=Ocean+Fair+International,+Dubai,+UAE',
                        color: '#2563eb',
                      }}
                    />
                  </div>
                </div>
                <!-- Details -->
                <div class='p-6 md:w-[60%] space-y-4'>
                  <div>
                    <h4 class='text-[11px] font-bold text-black/40 uppercase mb-1'>Address</h4>
                    <p class='text-[14px] text-gradient underline font-medium leading-tight'>
                      Office 3-43, A Diyar - Office 3, Rag Biz HQ Business Centre, Al Wasl, Sheikh Zayed Rd - Dubai,
                      United Arab Emirates.
                    </p>
                    <a
                      href='https://maps.google.com/?q=RAG+Biz+HQ+%7C+Business+Centre+in+Dubai'
                      target='_blank'
                      class='inline-block mt-3 px-6 py-1 border border-[#75317A33] rounded-full text-[12px] font-bold text-gradient hover:bg-[#75317A0D] transition-colors'
                    >
                      Get Directions
                    </a>
                  </div>
                  <div>
                    <h4 class='text-[11px] font-bold text-black/40 uppercase mb-0.5'>Warehouse</h4>
                    <p class='text-[14px] font-semibold text-black/80'>Ocean Fair International, Dubai</p>
                  </div>
                  <div>
                    <h4 class='text-[11px] font-bold text-black/40 uppercase mb-0.5'>Opening Hours</h4>
                    <p class='text-[14px] font-semibold text-black/80'>Mon - Sat: 8:00 AM - 5:00 PM</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
